ble enable-luminous-fast-follows enable-luminous-edit-box-updates" _nghost-ng-c817298775="" style="--max-lines-for-collapse-count:4;"><div _ngcontent-ng-c817298775="" class="user-query-container"><div _ngcontent-ng-c817298775="" class="file-preview-container ng-star-inserted"><!----><!----><!----><!----><!----><!----><!----></div><!----><div _ngcontent-ng-c817298775="" class="query-content ng-star-inserted" id="user-query-content-19" jslog="275422;track:impression,attention" data-hveid="0" decode-data-ved="1" data-ved="0CAAQ3ucQahcKEwjEs8Xqy_eWAxUAAAAAHQAAAAAQOw"><!----><!----><!----><!----><span _ngcontent-ng-c817298775="" data-test-id="luminous-collapsed-bubble" class="user-query-bubble-with-background luminous-collapsed ng-star-inserted" jslog="224552;track:generic_click,impression;BardVeMetadataKey:W1sicl8wZGI2Y2MzOGNjYmQ3OGUxIiwiY185MjE5MDhjNGM5YzIwMzhmIixudWxsLG51bGwsbnVsbCxudWxsLG51bGwsbnVsbCwxLG51bGwsbnVsbCxudWxsLDBdXQ==;mutable:true"><span _ngcontent-ng-c817298775="" class="horizontal-container ng-star-inserted"><div _ngcontent-ng-c817298775="" class="query-text gds-body-l collapsed" dir="ltr"><h5 _ngcontent-ng-c817298775="" class="cdk-visually-hidden screen-reader-user-query-label"><span _ngcontent-ng-c817298775="">あなたのプロンプト</span> なんだか分からなくなってしまったので、GitHubを一度削除しました。初めからやり直したいです。ファイルに入れたものは、漢字で介護、カタカナでパートナーサポートアプリと名前をつけてあります。ファイルご… <!----></h5><!----><p _ngcontent-ng-c817298775="" class="query-text-line ng-star-inserted"> なんだか分からなくなってしまったので、GitHubを一度削除しました。初めからやり直したいです。ファイルに入れたものは、漢字で介護、カタカナでパートナーサポートアプリと名前をつけてあります。ファイルごとドロップしてはいけないということで、ファイルを開いて、そうするとChromeマークのindexって、これをクリックするとホームページが出ます。その後に、今クリックしたらやっぱり文字だけの形になってました。その後に、もう1つmanifest.jsonというフォルダというかファイルがあります。それをクリックすると、出てこないな。メモ帳画面が出て、メモ帳を開くと、介護パートナーズの名前からちょこっとだけ載ってます。結局、箱をもう一度作り直したいです。教えてください。 <!----><!----><!----></p><!----><!----></div><!----></span><div _ngcontent-ng-c817298775="" class="luminous-toggle-container ng-star-inserted"><div _ngcontent-ng-c817298775="" class="luminous-expand-fade ng-star-inserted"></div><button _ngcontent-ng-c817298775="" mat-icon-button="" theme="lm" aria-label="開く" gemtooltip="テキストを開く" data-test-id="luminous-expand-button" class="mdc-icon-button mat-mdc-icon-button mat-mdc-button-base mat-mdc-tooltip-trigger luminous-toggle-button mat-unthemed lm-enabled ng-star-inserted" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" mat-ripple-loader-centered="" jslog="224552;track:generic_click,impression;BardVeMetadataKey:W1sicl8wZGI2Y2MzOGNjYmQ3OGUxIiwiY185MjE5MDhjNGM5YzIwMzhmIixudWxsLG51bGwsbnVsbCxudWxsLG51bGwsbnVsbCwxLG51bGwsbnVsbCxudWxsLDBdXQ==;mutable:true" aria-describedby="cdk-describedby-message-ng-1-15" cdk-describedby-host="ng-1"><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><div _ngcontent-ng-c817298775="" data-test-id="luminous-expand-pill" class="luminous-toggle-pill"><gem-icon _ngcontent-ng-c817298775="" fonticonname="expand_more" size="medium" _nghost-ng-c411899103=""><mat-icon _ngcontent-ng-c411899103="" role="img" class="mat-icon notranslate lm-icon-m lumi-symbols mat-ligature-font mat-icon-no-color ng-star-inserted" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="expand_more" data-mat-icon-namespace="lumi-symbols" fonticon="expand_more"></mat-icon><!----><!----><!----></gem-icon></div><!----><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----><!----></div><!----><!----><!----></span><!----><!----><!----><!----></div><div _ngcontent-ng-c817298775="" class="luminous-actions-container ng-star-inserted"><gem-icon-button _ngcontent-ng-c817298775="" tabindex="-1" theme="lm" type="onSurface" arialabel="プロンプトをコピー" gemtooltip="プロンプトをコピー" data-test-id="prompt-copy-button" class="mat-mdc-tooltip-trigger luminous-action-button gem-button gem-button-badge-size-small gem-button-size-small gem-button-type-on-surface lm-enabled" _nghost-ng-c1283807370="" aria-describedby="cdk-describedby-mes