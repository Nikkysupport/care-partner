-ng-1-139" cdk-describedby-host="ng-1"><!----><!----><button _ngcontent-ng-c1283807370="" maticonbutton="" matbadgeposition="after" class="mdc-icon-button mat-mdc-icon-button mat-mdc-button-base mat-badge mat-unthemed mat-badge-overlap mat-badge-above mat-badge-after mat-badge-small mat-badge-hidden ng-star-inserted" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" mat-ripple-loader-centered="" aria-label="閉じる" jslog="305704;track:generic_click,impression"><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><gem-icon _ngcontent-ng-c1283807370="" _nghost-ng-c411899103=""><mat-icon _ngcontent-ng-c411899103="" role="img" class="mat-icon notranslate lm-icon-l lumi-symbols mat-ligature-font mat-icon-no-color ng-star-inserted" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="close" data-mat-icon-namespace="lumi-symbols" fonticon="close"></mat-icon><!----><!----><!----></gem-icon><!----><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----></gem-icon-button><!----></div><div _ngcontent-ng-c3624015408="" class="iframe-wrapper"><!----><!----><!----><web-preview _ngcontent-ng-c3624015408="" class="code-content ng-star-inserted" _nghost-ng-c3871670825=""><div _ngcontent-ng-c3871670825="" class="container"><div><iframe allow="xr-spatial-tracking; web-share" sandbox="allow-pointer-lock allow-popups allow-forms allow-popups-to-escape-sandbox allow-downloads allow-same-origin allow-scripts" src="./介護パートナーサポートアプリicon_files/shim.html"></iframe></div></div><!----><!----></web-preview><!----><!----><!----><!----><!----><!----></div></div></inline-preview><!----><!----><!----><!----><!----></immersive-entry-chip><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></response-element></div><p data-path-to-node="4" class="pending"><span class="pending">「介護パートナーサポート」アプリを生成しました。</span><span class="pending">主な特徴は以下の通りです：</span></p><ul data-path-to-node="5" class="pending"><li class="pending"><p data-path-to-node="5,0,0" class="pending"><b data-path-to-node="5,0,0" data-index-in-node="0" class="pending">日々の記録</b><span class="pending">:</span><span class="pending"> ボタンひとつで体調・食事・服薬・排泄を記録し、</span><span class="pending">本日のタイムラインを構築します。</span></p></li><li class="pending"><p data-path-to-node="5,1,0" class="pending"><b data-path-to-node="5,1,0" data-index-in-node="0" class="pending">スケジュール管理</b><span class="pending">:</span><span class="pending"> デイサービスや通院予定などのリマインダーを管理できます。</span></p></li><li class="pending"><p data-path-to-node="5,2,0" class="pending"><b data-path-to-node="5,2,0" data-index-in-node="0" class="pending">申し送りメモ</b><span class="pending">:</span><span class="pending"> ヘルパーさんや家族間での連携メモを書き残せます。</span></p></li><li class="pending"><p data-path-to-node="5,3,0" class="pending"><b data-path-to-node="5,3,0" data-index-in-node="0" class="pending">介護者ストレスチェック</b><span class="pending">:</span><span class="pending"> 介護者ご自身のメンタルヘルス診断とアドバイス機能。</span></p></li><li class="pending"><p data-path-to-node="5,4,0" class="pending"><b data-path-to-node="5,4,0" data-index-in-node="0" class="pending">緊急連絡＆かかりつけ医カード</b><span class="pending">:</span><span class="pending"> 1タップで発信可能な緊急連絡先登録機能。</span></p></li></ul></div></message-content><!----></div></structured-content-container><!----><!----><!----><!----></model-response-content><div _ngcontent-ng-c1357127206="" class="response-footer complete gap"><!----><!----><!----><sources-list _ngcontent-ng-c1357127206="" class="sources-list ng-star-inserted"><!----></sources-list><!----><election-info-disclaimer _ngcontent-ng-c1357127206="" _nghost-ng-c