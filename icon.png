-star-inserted" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" mat-ripple-loader-centered="" aria-controls="user-query-content-19" aria-label="編集" jslog="173924;track:generic_click,impression;BardVeMetadataKey:W1sicl8wZGI2Y2MzOGNjYmQ3OGUxIiwiY185MjE5MDhjNGM5YzIwMzhmIixudWxsLG51bGwsbnVsbCxudWxsLG51bGwsbnVsbCwxLG51bGwsbnVsbCxudWxsLDBdXQ=="><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><gem-icon _ngcontent-ng-c1283807370="" _nghost-ng-c411899103=""><mat-icon _ngcontent-ng-c411899103="" role="img" class="mat-icon notranslate lm-icon-m lumi-symbols mat-ligature-font mat-icon-no-color ng-star-inserted" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="edit" data-mat-icon-namespace="lumi-symbols" fonticon="edit"></mat-icon><!----><!----><!----></gem-icon><!----><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----></gem-icon-button><!----><!----></div><!----><!----><!----><!----><!----><!----></div><!----><!----><!----><!----></user-query-content></span></user-query><!----><!----><!----><model-response _ngcontent-ng-c1725488290="" _nghost-ng-c1357127206="" class="enable-lr26-response-chrome-updates ng-star-inserted"><div _ngcontent-ng-c1357127206=""><response-container _ngcontent-ng-c1357127206="" _nghost-ng-c543715647="" class="ng-tns-c543715647-12 reduced-bottom-padding enable-lr26-response-chrome-updates enable-luminous-sources ng-star-inserted" jslog="188576;track:impression,attention;BardVeMetadataKey:W1sicl8wZGI2Y2MzOGNjYmQ3OGUxIiwiY185MjE5MDhjNGM5YzIwMzhmIixudWxsLG51bGwsbnVsbCxudWxsLG51bGwsbnVsbCwxLG51bGwsbnVsbCxudWxsLDBdXQ==;mutable:true" data-hveid="0" decode-data-ved="1" data-ved="0CAAQoMELahcKEwjEs8Xqy_eWAxUAAAAAHQAAAAAQPg"><div _ngcontent-ng-c543715647="" class="response-container response-container-with-gpi ng-tns-c543715647-12 no-background" jslog="173900;track:impression,attention" data-hveid="1"><!----><!----><div _ngcontent-ng-c543715647="" class="response-container-header ng-tns-c543715647-12 ng-star-inserted"><div _ngcontent-ng-c543715647="" class="response-container-header-controls ng-tns-c543715647-12"><div _ngcontent-ng-c543715647="" class="ng-tns-c543715647-12 tts ng-trigger ng-trigger-singleResponseEnter ng-star-inserted"><div _ngcontent-ng-c543715647="" class="single-draft-response-container ng-tns-c543715647-12"><!----></div></div><!----><!----></div><!----><!----><div _ngcontent-ng-c543715647="" class="response-container-header-status ng-tns-c543715647-12"><!----><div _ngcontent-ng-c543715647="" class="response-container-header-processing-state ng-tns-c543715647-12"></div></div></div><!----><div _ngcontent-ng-c543715647="" class="presented-response-container ng-tns-c543715647-12" jslog="283401;track:impression,attention" data-hveid="2"><!----><div _ngcontent-ng-c543715647="" class="response-container-content ng-tns-c543715647-12"><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><div _ngcontent-ng-c1357127206="" highlighttoaskhost="" class="response-content ng-tns-c543715647-12"><!----><!----><thinking-overlay _ngcontent-ng-c1357127206="" _nghost-ng-c2753012568="" class="enable-luminous-fast-follows ng-star-inserted"><!----></thinking-overlay><!----><!----><!----><!----><!----><!----><!----><!----><!----><div _ngcontent-ng-c1357127206="" class="model-response-label-announcer" aria-busy="false" aria-live="off"><!----><!----><h6 _ngcontent-ng-c1357127206="" class="cdk-visually-hidden screen-reader-model-response-label ng-star-inserted">Gemini の回答</h6><!----><!----></div><model-response-content _ngcontent-ng-c1357127206="" _nghost-ng-c652860866=""><!----><structured-content-container _ngcontent-ng-c652860866="" class="model-response-text processing-state-visible ng-star-inserted" _nghost-ng-c2289268078="" style="height: auto;"><div _ngcontent-ng-c2289268078="" class="container"><message-content _ngcontent-ng-c2289268078="" _nghost-ng-c1066623981="" id="message-content-id-r_0db6cc38ccbd78e1" class="ng-star-inserted"><div _ngcontent-ng-c1066623981="" inline-copy-host="" class="markdown markdown-main-panel md-content enable-luminous-fast-follows enable-updated-hr-color stronger" id="model-response-message-contentr_0db6cc38ccbd78e1" aria-busy="false" aria-live="off" dir="ltr" style="--animation-duration:400ms; --fade-animation-function:ease-out;"><p data-path-to-node="0">一度削除してリセットされたのですね！素晴らしい判断です。ごちゃごちゃした時は一度整理して最初からやり直すのが一番の近道です。</p><p data-path-to-node="1">手元にあるファイルの状態もすごくよく分かりました！状況を整理すると、以下のようになっていますね。</p><ol start="1" data-path-to-node="2"><li><p data-path-to-node="2,0,0"><b data-path-to-node="2,0,0" data-index-in-node="0"><code data-path-to-node="2,0,0" data-index-in-node="0">index</code>（または <code data-path-to-node="2,0,0" data-index-in-node="10">index.html</code>）</b>: Chromeマークがついたファイルです。</p></li><li><p data-path-to-node="2,1,0"><b data-path-to-node="2,1,0" data-index-in-node="0"><code data-path-to-node="2,1,0" data-index-in-node="0">manifest.json</code></b>: アプリの設定が入ったメモ帳のようなファイルです。</p></li></ol><p data-path-to-node="3"><code data-path-to-node="3" data-index-in-node="0">index</code> を開いたときに文字だけ（文字化け）になっていた点についても、<b data-path-to-node="3" data-index-in-node="36">保存する直前に「ある設定（文字コード）」を変えるだけで簡単に綺麗に直せます</b>。</p><p data-path-to-node="4">それでは、<b data-path-to-node="4" data-index-in-node="5">文字化けの直し</b>から<b data-path-to-node="4" data-index-in-node="14">GitHubの箱（リポジトリ）の再作成・ドロップ</b>まで、最初からひとつずつ進めていきましょう！</p><h3 data-path-to-node="6">【準備】文字化けを直して保存する</h3><p data-path-to-node="7">まず、手元にある <code data-path-to-node="7" data-index-in-node="9">index</code> ファイルの文字化けを直します。</p><ol start="1" data-path-to-node="8"><li><p data-path-to-node="8,0,0">パソコンの <b data-path-to-node="8,0,0" data-index-in-node="6">Chromeマークがついた <code data-path-to-node="8,0,0" data-index-in-node="20">index</code> ファイル</b> を右クリックします。</p></li><li><p data-path-to-node="8,1,0"><b data-path-to-node="8,1,0" data-index-in-node="0">「プログラムから開く」 ➔ 「メモ帳」</b> を選びます。（これでメモ帳で中身が開きます）</p></li><li><p data-path-to-node="8,2,0">メモ帳の左上にある <b data-path-to-node="8,2,0" data-index-in-node="10">「ファイル」 ➔ 「名前を付けて保存」</b> をクリックします。</p></li><li><p data-path-to-node="8,3,0">保存画面の一番下にある <b data-path-to-node="8,3,0" data-index-in-node="12">「文字コード」</b> という場所を確認します。</p></li><li><p data-path-to-node="8,4,0">そこをクリックして <b data-path-to-node="8,4,0" data-index-in-node="10">「UTF-8」</b> を選びます。</p></li><li><p data-path-to-node="8,5,0">ファイル名を <b data-path-to-node="8,5,0" data-index-in-node="7"><code data-path-to-node="8,5,0" data-index-in-node="7">index.html</code></b> にして <b data-path-to-node="8,5,0" data-index-in-node="22">「保存」</b>（上書き保存）を押します。</p></li></ol><h3 data-path-to-node="10">【ステップ1】GitHubで新しい箱（リポジトリ）を作る</h3><ol start="1" data-path-to-node="11"><li><p data-path-to-node="11,0,0">パソコンで <b data-path-to-node="11,0,0" data-index-in-node="6">GitHub（ <response-element class="no-md" ng-version="0.0.0-PLACEHOLDER"><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><link-block _nghost-ng-c2783832149="" class="ng-star-inserted"><!----><!----><a _ngcontent-ng-c2783832149="" target="_blank" rel="noopener" externallink="" _nghost-ng-c1785514107="" jslog="197247;track:generic_click,impression,attention;BardVeMetadataKey:W1sicl8wZGI2Y2MzOGNjYmQ3OGUxIiwiY185MjE5MDhjNGM5YzIwMzhmIixudWxsLCJyY19kNjA4NDRhNWMxNTE2M2VkIixudWxsLG51bGwsImphIixudWxsLDEsbnVsbCxudWxsLDEsMF1d" href="https://github.com/?utm_source=gemini" class="ng-star-inserted" data-hveid="3">https://github.com/</a><!----></link-block><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></response-element> ）</b> にログインします。</p></li><li><p data-path-to-node="11,1,0">画面右上にある <b data-path-to-node="11,1,0" data-index-in-node="8">「＋」マーク</b> をクリックし、<b data-path-to-node="11,1,0" data-index-in-node="22">「New repository」</b> を選びます。</p></li><li><p data-path-to-node="11,2,0"><b data-path-to-node="11,2,0" data-index-in-node="0">Repository name</b>（箱の名前）の枠に、半角英数字で <b data-path-to-node="11,2,0" data-index-in-node="32"><code data-path-to-node="11,2,0" data-index-in-node="32">care-partner</code></b> と入力します。</p></li><li><p data-path-to-node="11,3,0">画面を一番下までスクロールし、緑色の <b data-path-to-node="11,3,0" data-index-in-node="19">「Create repository」</b> ボタンを押します。</p></li></ol><h3 data-path-to-node="13">【ステップ2】ファイルを2つだけドロップする</h3><p data-path-to-node="14">箱ができると、英語がたくさん書かれた画面になります。</p><ol start="1" data-path-to-node="15"><li><p data-path-to-node="15,0,0">画面の中央あたりにある <b data-path-to-node="15,0,0" data-index-in-node="12">「uploading an existing file」</b> という青い文字のリンクをクリックします。</p><ul data-path-to-node="15,0,1"><li><p data-path-to-node="15,0,1,0,0"><i data-path-to-node="15,0,1,0,0" data-index-in-node="0">(※大きな点線の枠が表示されます)</i></p></li></ul></li><li><p data-path-to-node="15,1,0">フォルダ（漢字の介護…）を開き、中の <b data-path-to-node="15,1,0" data-index-in-node="19">2つのファイルだけ</b> をマウスでまとめて選択します：</p><ul data-path-to-node="15,1,1"><li><p data-path-to-node="15,1,1,0,0">📄 <b data-path-to-node="15,1,1,0,0" data-index-in-node="3"><code data-path-to-node="15,1,1,0,0" data-index-in-node="3">index.html</code></b>（Chromeマークのファイル）</p></li><li><p data-path-to-node="15,1,1,1,0">📄 <b data-path-to-node="15,1,1,1,0" data-index-in-node="3"><code data-path-to-node="15,1,1,1,0" data-index-in-node="3">manifest.json</code></b>（メモ帳マークのファイル）</p></li></ul></li><li><p data-path-to-node="15,2,0">この <b data-path-to-node="15,2,0" data-index-in-node="3">2つのファイルだけ</b> を、画面の大きな点線の枠の中に引っぱってドロップします。
<i data-path-to-node="15,2,0" data-index-in-node="42">(※フォルダごとはドロップしません！)</i></p></li><li><p data-path-to-node="15,3,0">画面の一番下にある緑色の <b data-path-to-node="15,3,0" data-index-in-node="13">「Commit changes」</b> ボタンを押します。</p></li></ol><h3 data-path-to-node="17">【ステップ3】ホームページとして公開設定（Pages）をする</h3><ol start="1" data-path-to-node="18"><li><p data-path-to-node="18,0,0">画面の上にある <b data-path-to-node="18,0,0" data-index-in-node="8">「Settings」</b>（歯車マーク ⚙️）をクリックします。</p></li><li><p data-path-to-node="18,1,0">左側のメニューから <b data-path-to-node="18,1,0" data-index-in-node="10">「Pages」</b> をクリックします。</p></li><li><p data-path-to-node="18,2,0"><b data-path-to-node="18,2,0" data-index-in-node="0">「Branch」</b> の項目にある <b data-path-to-node="18,2,0" data-index-in-node="16"><code data-path-to-node="18,2,0" data-index-in-node="16">None</code></b> をクリックして <b data-path-to-node="18,2,0" data-index-in-node="29"><code data-path-to-node="18,2,0" data-index-in-node="29">main</code></b>（または <code data-path-to-node="18,2,0" data-index-in-node="38">master</code>）に変えます。</p></li><li><p data-path-to-node="18,3,0">右側の <b data-path-to-node="18,3,0" data-index-in-node="4">「Save」</b> ボタンを押します。</p></li></ol><p data-path-to-node="20">これで完了です！
<b data-path-to-node="20" data-index-in-node="9">1〜3分ほど待ってから</b> ページを更新すると、画面の上に <b data-path-to-node="20" data-index-in-node="37"><code data-path-to-node="20" data-index-in-node="37">https://(あなたのユーザー名).github.io/care-partner/</code></b> というアドレスが表示されます。</p><p data-path-to-node="21">焦らずゆっくりで大丈夫です。途中で迷う場所があれば、いつでも止まって教えてくださいね！</p></div></message-content><!----></div></structured-content-container><!----><!----><!----><!----></model-response-content><div _ngcontent-ng-c1357127206="" class="response-footer complete gap"><!----><!----><!----><sources-list _ngcontent-ng-c1357127206="" class="sources-list ng-star-inserted"><!----></sources-list><!----><election-info-disclaimer _ngcontent-ng-c1357127206="" _nghost-ng-c2531033441="" style="display: none;" class="ng-star-inserted"><!----></election-info-disclaimer><finance-info-disclaimer _ngcontent-ng-c1357127206="" _nghost-ng-c1136367074="" style="display: none;" class="ng-star-inserted"><!----></finance-info-disclaimer><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></div></div><!----><!----><!----><sensitive-memories-banner _ngcontent-ng-c1357127206="" _nghost-ng-c746442083="" class="ng-star-inserted"><!----></sensitive-memories-banner><!----><!----><!----><!----></div></div><div _ngcontent-ng-c543715647="" class="response-container-footer ng-tns-c543715647-12 ng-star-inserted"><!----><!----><!----><message-actions _ngcontent-ng-c1357127206="" footer="" class="hide-on-print ng-tns-c3896640774-13 hide-action-bar ng-tns-c543715647-12 ng-star-inserted" _nghost-ng-c3896640774=""><div _ngcontent-ng-c3896640774="" class="actions-container-v2 ng-tns-c3896640774-13"><div _ngcontent-ng-c3896640774="" class="buttons-container-v2 ng-tns-c3896640774-13 ng-star-inserted"><!----><action-bar-buttons _ngcontent-ng-c3896640774="" _nghost-ng-c1559823796="" class="ng-tns-c3896640774-13 ng-star-inserted"><copy-button _ngcontent-ng-c1559823796="" _nghost-ng-c3634932602="" class="ng-star-inser