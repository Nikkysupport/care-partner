="" aria-controls="user-query-content-66" aria-label="編集" jslog="173924;track:generic_click,impression;BardVeMetadataKey:W1sicl83MTc4ODdlM2QzOTg5N2ZmIiwiY185MjE5MDhjNGM5YzIwMzhmIixudWxsLG51bGwsbnVsbCxudWxsLG51bGwsbnVsbCwxLG51bGwsbnVsbCxudWxsLDBdXQ=="><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><gem-icon _ngcontent-ng-c1283807370="" _nghost-ng-c411899103=""><mat-icon _ngcontent-ng-c411899103="" role="img" class="mat-icon notranslate lm-icon-m lumi-symbols mat-ligature-font mat-icon-no-color ng-star-inserted" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="edit" data-mat-icon-namespace="lumi-symbols" fonticon="edit"></mat-icon><!----><!----><!----></gem-icon><!----><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----></gem-icon-button><!----><!----></div><!----><!----><!----><!----><!----><!----></div><!----><!----><!----><!----></user-query-content></span></user-query><!----><!----><!----><model-response _ngcontent-ng-c1725488290="" _nghost-ng-c1357127206="" class="enable-lr26-response-chrome-updates ng-star-inserted"><div _ngcontent-ng-c1357127206=""><response-container _ngcontent-ng-c1357127206="" _nghost-ng-c543715647="" class="ng-tns-c543715647-233 reduced-bottom-padding enable-lr26-response-chrome-updates enable-luminous-sources ng-star-inserted" jslog="188576;track:impression,attention;BardVeMetadataKey:W1sicl83MTc4ODdlM2QzOTg5N2ZmIiwiY185MjE5MDhjNGM5YzIwMzhmIixudWxsLG51bGwsbnVsbCxudWxsLG51bGwsbnVsbCwxLG51bGwsbnVsbCxudWxsLDBdXQ==;mutable:true" data-hveid="0" decode-data-ved="1" data-ved="0CAAQoMELahgKEwjEs8Xqy_eWAxUAAAAAHQAAAAAQ8wg"><div _ngcontent-ng-c543715647="" class="response-container response-container-with-gpi ng-tns-c543715647-233 no-background response-container-has-multiple-responses" jslog="173900;track:impression,attention" data-hveid="1"><!----><!----><div _ngcontent-ng-c543715647="" class="response-container-header ng-tns-c543715647-233 ng-star-inserted"><div _ngcontent-ng-c543715647="" class="response-container-header-controls ng-tns-c543715647-233"><!----><!----></div><!----><!----><div _ngcontent-ng-c543715647="" class="response-container-header-status ng-tns-c543715647-233"><!----><div _ngcontent-ng-c543715647="" class="response-container-header-processing-state ng-tns-c543715647-233"></div></div></div><!----><div _ngcontent-ng-c543715647="" class="presented-response-container ng-tns-c543715647-233" jslog="283401;track:impression,attention" data-hveid="2"><!----><div _ngcontent-ng-c543715647="" class="response-container-content ng-tns-c543715647-233"><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><div _ngcontent-ng-c1357127206="" highlighttoaskhost="" class="response-content ng-tns-c543715647-233"><!----><!----><thinking-overlay _ngcontent-ng-c1357127206="" _nghost-ng-c2753012568="" class="enable-luminous-fast-follows ng-star-inserted"><!----></thinking-overlay><!----><!----><!----><!----><!----><!----><!----><!----><!----><div _ngcontent-ng-c1357127206="" class="model-response-label-announcer" aria-busy="false" aria-live="polite"><!----><!----><h6 _ngcontent-ng-c1357127206="" class="cdk-visually-hidden screen-reader-model-response-label ng-star-inserted">Gemini の回答</h6><!----><!----></div><model-response-content _ngcontent-ng-c1357127206="" _nghost-ng-c652860866=""><!----><structured-content-container _ngcontent-ng-c652860866="" class="model-response-text processing-state-visible ng-star-inserted" _nghost-ng-c2289268078="" style="height: auto;"><div _ngcontent-ng-c2289268078="" class="container"><message-content _ngcontent-ng-c2289268078="" _nghost-ng-c1066623981="" id="message-content-id-r_717887e3d39897ff" class="ng-star-inserted"><div _ngcontent-ng-c1066623981="" inline-copy-host="" class="markdown markdown-main-panel md-content enable-luminous-fast-follows enable-updated-hr-color stronger" id="model-response-message-contentr_717887e3d39897ff" aria-busy="false" aria-live="polite" dir="ltr" style="--animation-duration:400ms; --fade-animation-function:ease-out;"><p data-path-to-node="0">左上の温かいアイコンに決定ですね！このアイコンがスマホやパソコンの画面に並ぶのが楽しみです。</p><p data-path-to-node="1">心を込めて作った「介護パートナーサポート」を、周りの方々や現場の皆さんに便利に使ってもらうための具体的なアドバイスをまとめました。</p><h3 data-path-to-node="3">💡 アプリをみんなに広めて活用してもらう4つのステップ</h3><ol start="1" data-path-to-node="4"><li><p data-path-to-node="4,0,0"><b data-path-to-node="4,0,0" data-index-in-node="0">「URL（リンク）」を共有する</b></p><ul data-path-to-node="4,0,1"><li><p data-path-to-node="4,0,1,0,0">このアプリの一番の強みは、App StoreやGoogle Playで検索してダウンロードする必要がない（PWA）ことです。</p></li><li><p data-path-to-node="4,0,1,1,0">LINE、メール、QRコードなどで <code data-path-to-node="4,0,1,1,0" data-index-in-node="18">[https://Nikkysupport.github.io/care-partner/](https://Nikkysupport.github.io/care-partner/)</code> のリンクを送るだけで、誰でもすぐに開けます。</p></li></ul></li><li><p data-path-to-node="4,1,0"><b data-path-to-node="4,1,0" data-index-in-node="0">「ホーム画面・デスクトップ追加」のやり方を教えてあげる</b></p><ul data-path-to-node="4,1,1"><li><p data-path-to-node="4,1,1,0,0">「スマホの画面にこのアイコンを置いておくと、いつでも一発で開けるよ」と添えて教えてあげると親切です。</p></li><li><p data-path-to-node="4,1,1,1,0"><b data-path-to-node="4,1,1,1,0" data-index-in-node="0">iPhone/Android:</b> ブラウザのメニューから「ホーム画面に追加」</p></li><li><p data-path-to-node="4,1,1,2,0"><b data-path-to-node="4,1,1,2,0" data-index-in-node="0">パソコン:</b> Chromeの「ショートカットを作成」</p></li></ul></li><li><p data-path-to-node="4,2,0"><b data-path-to-node="4,2,0" data-index-in-node="0">身近な1人〜2人にまず使ってもらう（スモールスタート）</b></p><ul data-path-to-node="4,2,1"><li><p data-path-to-node="4,2,1,0,0">最初から大人数に広めるのではなく、まずは身近な職場の同僚やご家族に使ってもらいましょう。</p></li><li><p data-path-to-node="4,2,1,1,0">「使ってみてどう？使いづらいところはある？」と意見（フィードバック）をもらうと、さらにアプリを良くするヒントが得られます。</p></li></ul></li><li><p data-path-to-node="4,3,0"><b data-path-to-node="4,3,0" data-index-in-node="0">チラシや案内に「QRコード」を載せる</b></p><ul data-path-to-node="4,3,1"><li><p data-path-to-node="4,3,1,0,0">もし地域のイベントや事業所で配る紙があるなら、URLをQRコード（無料作成サイトで簡単に作れます）にして掲載しておくと、カメラで読み取るだけで使ってもらえるようになります。</p></li></ul></li></ol><p data-path-to-node="6">まずはアイコンの差し替えを完成させて、最初の一歩としてご自身のスマホやパソコンで新しいアイコンから起動する心地よさを味わってみてくださいね！</p></div></message-content><!----></div></structured-content-container><!----><!----><!----><!----></model-response-content><div _ngcontent-ng-c1357127206="" class="response-footer gap complete"><!----><!----><!----><sources-list _ngcontent-ng-c1357127206="" class="sources-list ng-star-inserted"><!----></sources-list><!----><election-info-disclaimer _ngcontent-ng-c1357127206="" _nghost-ng-c2531033441="" class="ng-star-inserted" style="display: none;"><!----></election-info-disclaimer><finance-info-disclaimer _ngcontent-ng-c1357127206="" _nghost-ng-c1136367074="" class="ng-star-inserted" style="display: none;"><!----></finance-info-disclaimer><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></div></div><!----><!----><!----><sensitive-memories-banner _ngcontent-ng-c1357127206="" _nghost-ng-c746442083="" class="ng-star-inserted" style=""><!----></sensitive-memories-banner><!----><!----><!----><!----></div></div><div _ngcontent-ng-c543715647="" class="response-container-footer ng-tns-c543715647-233 ng-star-inserted"><!----><!----><!----><message-actions _ngcontent-ng-c1357127206="" footer="" class="hide-on-print ng-tns-c3896640774-234 ng-star-inserted" _nghost-ng-c3896640774="" style=""><div _ngcontent-ng-c3896640774="" class="actions-container-v2 ng-tns-c3896640774-234"><div _ngcontent-ng-c3896640774="" class="buttons-container-v2 ng-tns-c3896640774-234 ng-star-inserted"><!----><action-bar-buttons _ngcontent-ng-c3896640774="" _nghost-ng-c1559823796="" class="ng-tns-c3896640774-234 ng-star-inserted"><copy-button _ngcontent-ng-c1559823796="" _nghost-ng-c3634932602="" class="ng-star-inserted"><gem-icon-button _ngcontent-ng-c3634932602="" tabindex="-1" theme="lm" type="onSurface" arialabel="コピー" gemtooltip="回答をコピー" class="mat-mdc-tooltip-trigger gem-button gem-button-badge-size-small gem-button-s