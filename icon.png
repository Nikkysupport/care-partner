924;track:generic_click,impression;BardVeMetadataKey:W1sicl8wMmZmZGZiNTVkZTEwOWQ2IiwiY185MjE5MDhjNGM5YzIwMzhmIixudWxsLG51bGwsbnVsbCxudWxsLG51bGwsbnVsbCwxLG51bGwsbnVsbCxudWxsLDBdXQ=="><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><gem-icon _ngcontent-ng-c1283807370="" _nghost-ng-c411899103=""><mat-icon _ngcontent-ng-c411899103="" role="img" class="mat-icon notranslate lm-icon-m lumi-symbols mat-ligature-font mat-icon-no-color ng-star-inserted" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="edit" data-mat-icon-namespace="lumi-symbols" fonticon="edit"></mat-icon><!----><!----><!----></gem-icon><!----><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----></gem-icon-button><!----><!----></div><!----><!----><!----><!----><!----><!----></div><!----><!----><!----><!----></user-query-content></span></user-query><!----><!----><!----><model-response _ngcontent-ng-c1725488290="" _nghost-ng-c1357127206="" class="enable-lr26-response-chrome-updates ng-star-inserted"><div _ngcontent-ng-c1357127206=""><response-container _ngcontent-ng-c1357127206="" _nghost-ng-c543715647="" class="ng-tns-c543715647-141 reduced-bottom-padding enable-lr26-response-chrome-updates enable-luminous-sources ng-star-inserted" jslog="188576;track:impression,attention;BardVeMetadataKey:W1sicl8wMmZmZGZiNTVkZTEwOWQ2IiwiY185MjE5MDhjNGM5YzIwMzhmIixudWxsLG51bGwsbnVsbCxudWxsLG51bGwsbnVsbCwxLG51bGwsbnVsbCxudWxsLDBdXQ==;mutable:true" data-hveid="0" decode-data-ved="1" data-ved="0CAAQoMELahgKEwjEs8Xqy_eWAxUAAAAAHQAAAAAQ5wU"><div _ngcontent-ng-c543715647="" class="response-container response-container-with-gpi ng-tns-c543715647-141 no-background" jslog="173900;track:impression,attention" data-hveid="1"><!----><!----><div _ngcontent-ng-c543715647="" class="response-container-header ng-tns-c543715647-141 ng-star-inserted"><div _ngcontent-ng-c543715647="" class="response-container-header-controls ng-tns-c543715647-141"><div _ngcontent-ng-c543715647="" class="ng-tns-c543715647-141 tts ng-trigger ng-trigger-singleResponseEnter ng-star-inserted"><div _ngcontent-ng-c543715647="" class="single-draft-response-container ng-tns-c543715647-141"><!----></div></div><!----><!----></div><!----><!----><div _ngcontent-ng-c543715647="" class="response-container-header-status ng-tns-c543715647-141"><!----><div _ngcontent-ng-c543715647="" class="response-container-header-processing-state ng-tns-c543715647-141"></div></div></div><!----><div _ngcontent-ng-c543715647="" class="presented-response-container ng-tns-c543715647-141" jslog="283401;track:impression,attention" data-hveid="2"><!----><div _ngcontent-ng-c543715647="" class="response-container-content ng-tns-c543715647-141"><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><div _ngcontent-ng-c1357127206="" highlighttoaskhost="" class="response-content ng-tns-c543715647-141"><!----><!----><thinking-overlay _ngcontent-ng-c1357127206="" _nghost-ng-c2753012568="" class="enable-luminous-fast-follows ng-star-inserted"><!----></thinking-overlay><!----><!----><!----><!----><!----><!----><!----><!----><!----><div _ngcontent-ng-c1357127206="" class="model-response-label-announcer" aria-busy="false" aria-live="off"><!----><!----><h6 _ngcontent-ng-c1357127206="" class="cdk-visually-hidden screen-reader-model-response-label ng-star-inserted" style="">Gemini の回答</h6><!----><!----></div><model-response-content _ngcontent-ng-c1357127206="" _nghost-ng-c652860866=""><!----><structured-content-container _ngcontent-ng-c652860866="" class="model-response-text processing-state-visible ng-star-inserted" _nghost-ng-c2289268078="" style="height: auto;"><div _ngcontent-ng-c2289268078="" class="container"><message-content _ngcontent-ng-c2289268078="" _nghost-ng-c1066623981="" id="message-content-id-r_02ffdfb55de109d6" class="ng-star-inserted"><div _ngcontent-ng-c1066623981="" inline-copy-host="" class="markdown markdown-main-panel md-content enable-luminous-fast-follows enable-updated-hr-color stronger" id="model-response-message-contentr_02ffdfb55de109d6" aria-busy="false" aria-live="off" dir="ltr" style="--animation-duration:400ms; --fade-animation-function:ease-out;"><p data-path-to-node="0">Netlifyでの公開とスマホのホーム画面追加、本当におめでとうございます！素晴らしいです！</p><p data-path-to-node="1">次に「GitHub（ギットハブ）」を設定しておくと、「アプリのコードを安全に永久保存（バックアップ）できる」「コードを書き換えたら自動でNetlifyのアプリも最新に更新される」という大きなメリットがあります。</p><p data-path-to-node="2">GitHubも<b data-path-to-node="2" data-index-in-node="7">完全無料</b>で利用できます！ゆっくり順を追って進めていきましょう。</p><h3 data-path-to-node="4">🟢 ステップ1：GitHubのアカウントを作る（無料）</h3><p data-path-to-node="5">まずは、GitHubの公式サイトで無料のアカウントを作成します。</p><ol start="1" data-path-to-node="6"><li><p data-path-to-node="6,0,0">パソコンで以下のGitHub公式サイトを開きます。
👉 <b data-path-to-node="6,0,0" data-index-in-node="29"><response-element class="no-md" ng-version="0.0.0-PLACEHOLDER"><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><link-block _nghost-ng-c2783832149="" class="ng-star-inserted"><!----><!----><a _ngcontent-ng-c2783832149="" target="_blank" rel="noopener" externallink="" _nghost-ng-c1785514107="" jslog="197247;track:generic_click,impression,attention;BardVeMetadataKey:W1sicl8wMmZmZGZiNTVkZTEwOWQ2IiwiY185MjE5MDhjNGM5YzIwMzhmIixudWxsLCJyY18yZjkxZDA3YjYyMzExNmE0IixudWxsLG51bGwsImphIixudWxsLDEsbnVsbCxudWxsLDEsMF1d" href="https://github.com/?utm_source=gemini" class="ng-star-inserted" data-hveid="3">https://github.com/</a><!----></link-block><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></response-element></b></p></li><li><p data-path-to-node="6,1,0">画面右上にある <b data-path-to-node="6,1,0" data-index-in-node="8">「Sign up」</b>（サインアップ）というボタンをクリックします。</p></li><li><p data-path-to-node="6,2,0">画面の案内に沿って入力します：</p><ul data-path-to-node="6,2,1"><li><p data-path-to-node="6,2,1,0,0"><b data-path-to-node="6,2,1,0,0" data-index-in-node="0">Enter your email</b>: ご自身のメールアドレスを入力 ➔ <code data-path-to-node="6,2,1,0,0" data-index-in-node="35">Continue</code></p></li><li><p data-path-to-node="6,2,1,1,0"><b data-path-to-node="6,2,1,1,0" data-index-in-node="0">Create a password</b>: パスワードを決めて入力 ➔ <code data-path-to-node="6,2,1,1,0" data-index-in-node="33">Continue</code></p></li><li><p data-path-to-node="6,2,1,2,0"><b data-path-to-node="6,2,1,2,0" data-index-in-node="0">Enter a username</b>: 好きなユーザー名（半角英数字）を入力 ➔ <code data-path-to-node="6,2,1,2,0" data-index-in-node="39">Continue</code></p></li></ul></li><li><p data-path-to-node="6,3,0">最後に簡単なパズル（人間チェック）を解いて、メールに届いた認証コードを入力すればアカウント作成完了です！</p></li></ol><h3 data-path-to-node="8">🟢 ステップ2：ファイルを入れる箱（リポジトリ）を作る</h3><p data-path-to-node="9">アカウントができたら、アプリのファイルを保存する「箱」を作ります。</p><ol start="1" data-path-to-node="10"><li><p data-path-to-node="10,0,0">GitHubにログインした状態で、画面右上にある <b data-path-to-node="10,0,0" data-index-in-node="25">「＋」マーク</b> を押し、<b data-path-to-node="10,0,0" data-index-in-node="36">「New repository」</b> をクリックします。</p></li><li><p data-path-to-node="10,1,0"><b data-path-to-node="10,1,0" data-index-in-node="0">Repository name</b>（箱の名前）に、たとえば <code data-path-to-node="10,1,0" data-index-in-node="28">care-partner-app</code> と入力します。</p></li><li><p data-path-to-node="10,2,0"><b data-path-to-node="10,2,0" data-index-in-node="0">Public</b>（公開）を選んだままにします。</p></li><li><p data-path-to-node="10,3,0">画面の一番下にある緑色の <b data-path-to-node="10,3,0" data-index-in-node="13">「Create repository」</b> ボタンを押します。</p></li></ol><h3 data-path-to-node="12">🟢 ステップ3：パソコンからファイルをアップロードする</h3><p data-path-to-node="13">箱ができたら、パソコンにある <code data-path-to-node="13" data-index-in-node="15">index.html</code> などをドラッグ＆ドロップで入れます！</p><ol start="1" data-path-to-node="14"><li><p data-path-to-node="14,0,0">画面の中に <b data-path-to-node="14,0,0" data-index-in-node="6">「uploading an existing file」</b> という青い文字のリンクがあるので、それをクリックします。</p></li><li><p data-path-to-node="14,1,0">Netlifyの時と同じように、パソコンの <code data-path-to-node="14,1,0" data-index-in-node="22">index.html</code>（やその他のファイル）を画面の中央に<b data-path-to-node="14,1,0" data-index-in-node="50">ドラッグ＆ドロップ</b>します。</p></li><li><p data-path-to-node="14,2,0">画面下にある緑色の <b data-path-to-node="14,2,0" data-index-in-node="10">「Commit changes」</b> ボタンを押します。</p></li></ol><p data-path-to-node="16">これで、GitHub上にご自身のアプリのコードが安全に保管されました！</p><p data-path-to-node="17">アカウント作成やアップロードで「英語が多くてわかりにくい」「ここで止まった」などがあれば、いつでも教えてくださいね。ひとつずつサポートします！</p></div></message-content><!----></div></structured-content-container><!----><!----><!----><!----></model-response-content><div _ngcontent-ng-c1357127206="" class="response-footer complete gap"><!----><!----><!----><sources-list _ngcontent-ng-c1357127206="" class="sources-list ng-star-inserted" style=""><!----></sources-list><!----><election-info-disclaimer _ngcontent-ng-c1357127206="" _nghost-ng-c2531033441="" class="ng-star-inserted" style="display: none;"><!----></election-info-disclaimer><finance-info-disclaimer _ngcontent-ng-c1357127206="" _nghost-ng-c1136367074="" class="ng-star-inserted" style="display: none;"><!----></finance-info-disclaimer><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></div></div><!----><!----><!----><sensitive-memories-banner _ngcontent-ng-c1357127206="" _nghost-ng-c746442083="" class="ng-star-inserted"><!----></sensitive-memories-banner><!----><!----><!----><!----></div></div><div _ngcontent-ng-c543715647="" class="response-container-footer ng-tns-c543715647-141 ng-star-inserted"><!----><!----><!----><message-actions _ngcontent-ng-c1357127206="" footer="" class="hide-on-print ng-tns-c3896640774-142 hide-action-bar ng-tns-c543715647-141 ng-star-inserted" _nghost-ng-c3896640774=""><div _ngcontent-ng-c3896640774="" class="actions-container-v2 ng-tns-c3896640774-142"><div _ngcontent-ng-c3896640774="" class="buttons-container-v2 ng-tns-c3896640774-142 ng-star-inserted"><!----><action-bar-buttons _ngcontent-ng-c3896640774="" _nghost-ng-c1559823796="" class="ng-tns-c3896640774-142 ng-star-inserted"><copy-button _ngcontent-ng-c1559823796="" _nghost-ng-c3634932602="" class="ng-star-inserted"><gem-icon-button _ngcontent-ng-c3634932602="" tabindex="-1" theme="lm" type="onSurface" arialabel="コピー" gemtooltip="回答をコピー" class="mat-mdc-tooltip-trigger gem-button gem-button-badge-size-small gem-button-size-small gem-button-type-on-surface lm-enabled ng-st