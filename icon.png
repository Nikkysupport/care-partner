                            <span class="hljs-tag">&lt;<span class="hljs-name">p</span>&gt;</span>ひまわりケアセンター<span class="hljs-tag">&lt;/<span class="hljs-name">p</span>&gt;</span>
                        <span class="hljs-tag">&lt;/<span class="hljs-name">div</span>&gt;</span>
                        <span class="hljs-tag">&lt;<span class="hljs-name">a</span> <span class="hljs-attr">href</span>=<span class="hljs-string">"tel:0000000000"</span> <span class="hljs-attr">class</span>=<span class="hljs-string">"call-btn"</span>&gt;</span><span class="hljs-tag">&lt;<span class="hljs-name">i</span> <span class="hljs-attr">class</span>=<span class="hljs-string">"fa-solid fa-phone"</span>&gt;</span><span class="hljs-tag">&lt;/<span class="hljs-name">i</span>&gt;</span><span class="hljs-tag">&lt;/<span class="hljs-name">a</span>&gt;</span>
                    <span class="hljs-tag">&lt;/<span class="hljs-name">div</span>&gt;</span>
                <span class="hljs-tag">&lt;/<span class="hljs-name">div</span>&gt;</span>

                <span class="hljs-tag">&lt;<span class="hljs-name">div</span> <span class="hljs-attr">class</span>=<span class="hljs-string">"card"</span>&gt;</span>
                    <span class="hljs-tag">&lt;<span class="hljs-name">div</span> <span class="hljs-attr">class</span>=<span class="hljs-string">"card-title"</span>&gt;</span>
                        <span class="hljs-tag">&lt;<span class="hljs-name">i</span> <span class="hljs-attr">class</span>=<span class="hljs-string">"fa-solid fa-address-card"</span> <span class="hljs-attr">style</span>=<span class="hljs-string">"background: linear-gradient(135deg, #FF9F43, #FEB47B);"</span>&gt;</span><span class="hljs-tag">&lt;/<span class="hljs-name">i</span>&gt;</span>
                        ご本人の情報メモ
                    <span class="hljs-tag">&lt;/<span class="hljs-name">div</span>&gt;</span>
                    <span class="hljs-tag">&lt;<span class="hljs-name">p</span> <span class="hljs-attr">style</span>=<span class="hljs-string">"font-size: 0.88rem; color: var(--text-sub); line-height: 1.6;"</span>&gt;</span>
                        <span class="hljs-tag">&lt;<span class="hljs-name">strong</span>&gt;</span>お名前:<span class="hljs-tag">&lt;/<span class="hljs-name">strong</span>&gt;</span> 山田 花子 様 (85歳)<span class="hljs-tag">&lt;<span class="hljs-name">br</span>&gt;</span>
                        <span class="hljs-tag">&lt;<span class="hljs-name">strong</span>&gt;</span>要介護度:<span class="hljs-tag">&lt;/<span class="hljs-name">strong</span>&gt;</span> 要介護 2<span class="hljs-tag">&lt;<span class="hljs-name">br</span>&gt;</span>
                        <span class="hljs-tag">&lt;<span class="hljs-name">strong</span>&gt;</span>持病:<span class="hljs-tag">&lt;/<span class="hljs-name">strong</span>&gt;</span> 高血圧、腰痛<span class="hljs-tag">&lt;<span class="hljs-name">br</span>&gt;</span>
                        <span class="hljs-tag">&lt;<span class="hljs-name">strong</span>&gt;</span>かかりつけ薬局:<span class="hljs-tag">&lt;/<span class="hljs-name">strong</span>&gt;</span> ぽかぽか薬局
                    <span class="hljs-tag">&lt;/<span class="hljs-name">p</span>&gt;</span>
                <span class="hljs-tag">&lt;/<span class="hljs-name">div</span>&gt;</span>
            <span class="hljs-tag">&lt;/<span class="hljs-name">section</span>&gt;</span>
        <span class="hljs-tag">&lt;/<span class="hljs-name">main</span>&gt;</span>

        <span class="hljs-comment">&lt;!-- Bottom Nav --&gt;</span>
        <span class="hljs-tag">&lt;<span class="hljs-name">nav</span> <span class="hljs-attr">class</span>=<span class="hljs-string">"bottom-nav"</span>&gt;</span>
            <span class="hljs-tag">&lt;<span class="hljs-name">button</span> <span class="hljs-attr">class</span>=<span class="hljs-string">"nav-item active"</span> <span class="hljs-attr">onclick</span>=<span class="hljs-string">"switchTab('home', this)"</span>&gt;</span>
                <span class="hljs-tag">&lt;<span class="hljs-name">i</span> <span class="hljs-attr">class</span>=<span class="hljs-string">"fa-solid fa-calendar-check"</span>&gt;</span><span class="hljs-tag">&lt;/<span class="hljs-name">i</span>&gt;</span>
                <span class="hljs-tag">&lt;<span class="hljs-name">span</span>&gt;</span>記録<span class="hljs-tag">&lt;/<span class="hljs-name">span</span>&gt;</span>
            <span class="hljs-tag">&lt;/<span class="hljs-name">button</span>&gt;</span>
            <span class="hljs-tag">&lt;<span class="hljs-name">button</span> <span class="hljs-attr">class</span>=<span class="hljs-string">"nav-item"</span> <span class="hljs-attr">onclick</span>=<span class="hljs-string">"switchTab('memo', this)"</span>&gt;</span>
                <span class="hljs-tag">&lt;<span class="hljs-name">i</span> <span class="hljs-attr">class</span>=<span class="hljs-string">"fa-solid fa-comment-dots"</span>&gt;</span><span class="hljs-tag">&lt;/<span class="hljs-name">i</span>&gt;</span>
                <span class="hljs-tag">&lt;<span class="hljs-name">span</span>&gt;</span>申し送り<span class="hljs-tag">&lt;/<span class="hljs-name">span</span>&gt;</span>
            <span class="hljs-tag">&lt;/<span class="hljs-name">button</span>&gt;</span>
            <span class="hljs-tag">&lt;<span class="hljs-name">button</span> <span class="hljs-attr">class</span>=<span class="hljs-string">"nav-item"</span> <span class="hljs-attr">onclick</span>=<span class="hljs-string">"switchTab('care', this)"</span>&gt;</span>
                <span class="hljs-tag">&lt;<span class="hljs-name">i</span> <span class="hljs-attr">class</span>=<span class="hljs-string">"fa-solid fa-heart"</span>&gt;</span><span class="hljs-tag">&lt;/<span class="hljs-name">i</span>&gt;</span>
                <span class="hljs-tag">&lt;<span class="hljs-name">span</span>&gt;</span>セルフケア<span class="hljs-tag">&lt;/<span class="hljs-name">span</span>&gt;</span>
            <span class="hljs-tag">&lt;/<span class="hljs-name">button</span>&gt;</span>
            <span class="hljs-tag">&lt;<span class="hljs-name">button</span> <span class="hljs-attr">class</span>=<span class="hljs-string">"nav-item"</span> <span class="hljs-attr">onclick</span>=<span class="hljs-string">"switchTab('contacts', this)"</span>&gt;</span>
                <span class="hljs-tag">&lt;<span class="hljs-name">i</span> <span class="hljs-attr">class</span>=<span class="hljs-string">"fa-solid fa-phone-volume"</span>&gt;</span><span class="hljs-tag">&lt;/<span class="hljs-name">i</span>&gt;</span>
                <span class="hljs-tag">&lt;<span class="hljs-name">span</span>&gt;</span>緊急・連絡<span class="hljs-tag">&lt;/<span class="hljs-name">span</span>&gt;</span>
            <span class="hljs-tag">&lt;/<span class="hljs-name">button</span>&gt;</span>
        <span class="hljs-tag">&lt;/<span class="hljs-name">nav</span>&gt;</span>
    <span class="hljs-tag">&lt;/<span class="hljs-name">div</span>&gt;</span>

    <span class="hljs-comment">&lt;!-- Modal Dialog --&gt;</span>
    <span class="hljs-tag">&lt;<span class="hljs-name">div</span> <span class="hljs-attr">class</span>=<span class="hljs-string">"modal"</span> <span class="hljs-attr">id</span>=<span class="hljs-string">"recordModal"</span>&gt;</span>
        <span class="hljs-tag">&lt;<span class="hljs-name">div</span> <span class="hljs-attr">class</span>=<span class="hljs-string">"modal-content"</span>&gt;</span>
            <span class="hljs-tag">&lt;<span class="hljs-name">div</span> <span class="hljs-attr">class</span>=<span class="hljs-string">"card-title"</span> <span class="hljs-attr">id</span>=<span class="hljs-string">"modalTitle"</span>&gt;</span>記録を追加<span class="hljs-tag">&lt;/<span class="hljs-name">div</span>&gt;</span>
            <span class="hljs-tag">&lt;<span class="hljs-name">div</span> <span class="hljs-attr">class</span>=<span class="hljs-string">"form-group"</span>&gt;</span>
                <span class="hljs-tag">&lt;<span class="hljs-name">label</span> <span class="hljs-attr">style</span>=<span class="hljs-string">"font-size: 0.85rem; font-weight: bold; color: var(--text-sub); display: block; margin-bottom: 6px;"</span>&gt;</span>内容・一言メモ<span class="hljs-tag">&lt;/<span class="hljs-name">label</span>&gt;</span>
                <span class="hljs-tag">&lt;<span class="hljs-name">input</span> <span class="hljs-attr">type</span>=<span class="hljs-string">"text"</span> <span class="hljs-attr">id</span>=<span class="hljs-string">"modalDetail"</span> <span class="hljs-attr">class</span>=<span class="hljs-string">"form-control"</span> <span class="hljs-attr">placeholder</span>=<span class="hljs-string">"例: 完食、血圧120/80など"</span>&gt;</span>
            <span class="hljs-tag">&lt;/<span class="hljs-name">div</span>&gt;</span>
            <span class="hljs-tag">&lt;<span class="hljs-name">div</span> <span class="hljs-attr">style</span>=<span class="hljs-string">"display: flex; gap: 10px; margin-top: 16px;"</span>&gt;</span>
                <span class="hljs-tag">&lt;<span class="hljs-name">button</span> <span class="hljs-attr">class</span>=<span class="hljs-string">"btn btn-outline"</span> <span class="hljs-attr">onclick</span>=<span class="hljs-string">"closeModal()"</span>&gt;</span>キャンセル<span class="hljs-tag">&lt;/<span class="hljs-name">button</span>&gt;</span>
                <span class="hljs-tag">&lt;<span class="hljs-name">button</span> <span class="hljs-attr">class</span>=<span class="hljs-string">"btn"</span> <span class="hljs-attr">onclick</span>=<span class="hljs-string">"saveLog()"</span>&gt;</span>保存する<span class="hljs-tag">&lt;/<span class="hljs-name">button</span>&gt;</span>
            <span class="hljs-tag">&lt;/<span class="hljs-name">div</span>&gt;</span>
        <span class="hljs-tag">&lt;/<span class="hljs-name">div</span>&gt;</span>
    <span class="hljs-tag">&lt;/<span class="hljs-name">div</span>&gt;</span>

    <span class="hljs-comment">&lt;!-- App Logic --&gt;</span>
    <span class="hljs-tag">&lt;<span class="hljs-name">script</span>&gt;</span><span class="javascript">
        <span class="hljs-comment">// Header Date</span>
        <span class="hljs-keyword">const</span> dateElement = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'currentDate'</span>);
        <span class="hljs-keyword">const</span> now = <span class="hljs-keyword">new</span> <span class="hljs-built_in">Date</span>();
        <span class="hljs-keyword">const</span> options = { <span class="hljs-attr">month</span>: <span class="hljs-string">'short'</span>, <span class="hljs-attr">day</span>: <span class="hljs-string">'numeric'</span>, <span class="hljs-attr">weekday</span>: <span class="hljs-string">'short'</span> };
        dateElement.textContent = now.toLocaleDateString(<span class="hljs-string">'ja-JP'</span>, options);

        <span class="hljs-comment">// Data Management</span>
        <span class="hljs-keyword">let</span> logs = <span class="hljs-built_in">JSON</span>.parse(<span class="hljs-built_in">localStorage</span>.getItem(<span class="hljs-string">'care_logs_orange'</span>)) || [
            { <span class="hljs-attr">type</span>: <span class="hljs-string">'服薬'</span>, <span class="hljs-attr">detail</span>: <span class="hljs-string">'朝の薬（降圧剤）をしっかり服用'</span>, <span class="hljs-attr">time</span>: <span class="hljs-string">'08:30'</span> },
            { <span class="hljs-attr">type</span>: <span class="hljs-string">'食事'</span>, <span class="hljs-attr">detail</span>: <span class="hljs-string">'朝食 完食（トースト、トマトスープ）'</span>, <span class="hljs-attr">time</span>: <span class="hljs-string">'08:00'</span> }
        ];

        <span class="hljs-keyword">let</span> memos = <span class="hljs-built_in">JSON</span>.parse(<span class="hljs-built_in">localStorage</span>.getItem(<span class="hljs-string">'care_memos_orange'</span>)) || [
            <span class="hljs-string">'午後は風が心地よいので少しお散歩しましょう'</span>,
            <span class="hljs-string">'水分補給用に麦茶を作って冷蔵庫に入れてあります'</span>
        ];

        <span class="hljs-keyword">let</span> currentCategory = <span class="hljs-string">''</span>;

        <span class="hljs-comment">// Tab Navigation</span>
        <span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">switchTab</span>(<span class="hljs-params">tabId, element</span>) </span>{
            <span class="hljs-built_in">document</span>.querySelectorAll(<span class="hljs-string">'.tab-content'</span>).forEach(<span class="hljs-function"><span class="hljs-params">tab</span> =&gt;</span> tab.classList.remove(<span class="hljs-string">'active'</span>));
            <span class="hljs-built_in">document</span>.querySelectorAll(<span class="hljs-string">'.nav-item'</span>).forEach(<span class="hljs-function"><span class="hljs-params">nav</span> =&gt;</span> nav.classList.remove(<span class="hljs-string">'active'</span>));

            <span class="hljs-built_in">document</span>.getElementById(tabId).classList.add(<span class="hljs-string">'active'</span>);
            element.classList.add(<span class="hljs-string">'active'</span>);
        }

        <span class="hljs-comment">// Modal Logic</span>
        <span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">openModal</span>(<span class="hljs-params">category</span>) </span>{
            currentCategory = category;
            <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'modalTitle'</span>).innerText = category + <span class="hljs-string">' の記録'</span>;
            <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'modalDetail'</span>).value = <span class="hljs-string">''</span>;
            <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'recordModal'</span>).classList.add(<span class="hljs-string">'active'</span>);
        }

        <span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">closeModal</span>(<span class="hljs-params"></span>) </span>{
            <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'recordModal'</span>).classList.remove(<span class="hljs-string">'active'</span>);
        }

        <span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">saveLog</span>(<span class="hljs-params"></span>) </span>{
            <span class="hljs-keyword">const</span> detail = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'modalDetail'</span>).value || <span class="hljs-string">'記録なし'</span>;
            <span class="hljs-keyword">const</span> timeStr = <span class="hljs-keyword">new</span> <span class="hljs-built_in">Date</span>().toLocaleTimeString(<span class="hljs-string">'ja-JP'</span>, { <span class="hljs-attr">hour</span>: <span class="hljs-string">'2-digit'</span>, <span class="hljs-attr">minute</span>: <span class="hljs-string">'2-digit'</span> });

            logs.unshift({ <span class="hljs-attr">type</span>: currentCategory, <span class="hljs-attr">detail</span>: detail, <span class="hljs-attr">time</span>: timeStr });
            <span class="hljs-built_in">localStorage</span>.setItem(<span class="hljs-string">'care_logs_orange'</span>, <span class="hljs-built_in">JSON</span>.stringify(logs));

            renderLogs();
            closeModal();
        }

        <span class="hljs-comment">// Render Logs Timeline</span>
        <span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">renderLogs</span>(<span class="hljs-params"></span>) </span>{
            <span class="hljs-keyword">const</span> logContainer = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'logList'</span>);
            logContainer.innerHTML = <span class="hljs-string">''</span>;

            <span class="hljs-keyword">const</span> styleMap = {
                <span class="hljs-string">'食事'</span>: { <span class="hljs-attr">icon</span>: <span class="hljs-string">'fa-utensils'</span>, <span class="hljs-attr">bg</span>: <span class="hljs-string">'linear-gradient(135deg, #FF7E5F, #FEB47B)'</span> },
                <span class="hljs-string">'服薬'</span>: { <span class="hljs-attr">icon</span>: <span class="hljs-string">'fa-pills'</span>, <span class="hljs-attr">bg</span>: <span class="hljs-string">'linear-gradient(135deg, #FF9F43, #FFC048)'</span> },
                <span class="hljs-string">'排泄'</span>: { <span class="hljs-attr">icon</span>: <span class="hljs-string">'fa-restroom'</span>, <span class="hljs-attr">bg</span>: <span class="hljs-string">'linear-gradient(135deg, #F9CA24, #F0932B)'</span> },
                <span class="hljs-string">'体調'</span>: { <span class="hljs-attr">icon</span>: <span class="hljs-string">'fa-heart-pulse'</span>, <span class="hljs-attr">bg</span>: <span class="hljs-string">'linear-gradient(135deg, #EB4D4B, #FF7E5F)'</span> }
            };

            <span class="hljs-keyword">if</span> (logs.length === <span class="hljs-number">0</span>) {
                logContainer.innerHTML = <span class="hljs-string">'&lt;p style="text-align:center; color:var(--text-sub); font-size:0.85rem; padding: 10px;"&gt;記録はまだありません✨&lt;/p&gt;'</span>;
                <span class="hljs-keyword">return</span>;
            }

            logs.forEach(<span class="hljs-function">(<span class="hljs-params">log</span>) =&gt;</span> {
                <span class="hljs-keyword">const</span> style = styleMap[log.type] || { <span class="hljs-attr">icon</span>: <span class="hljs-string">'fa-clipboard'</span>, <span class="hljs-attr">bg</span>: <span class="hljs-string">'linear-gradient(135deg, #FF9F43, #FEB47B)'</span> };
                <span class="hljs-keyword">const</span> item = <span class="hljs-built_in">document</span>.createElement(<span class="hljs-string">'div'</span>);
                item.className = <span class="hljs-string">'log-item'</span>;
                item.innerHTML = <span class="hljs-string">`
                    &lt;div class="log-time"&gt;<span class="hljs-subst">${log.time}</span>&lt;/div&gt;
                    &lt;div class="log-icon" style="background: <span class="hljs-subst">${style.bg}</span>;"&gt;&lt;i class="fa-solid <span class="hljs-subst">${style.icon}</span>"&gt;&lt;/i&gt;&lt;/div&gt;
                    &lt;div class="log-content"&gt;
                        &lt;div class="log-title"&gt;<span class="hljs-subst">${log.type}</span>&lt;/div&gt;
                        &lt;div class="log-detail"&gt;<span class="hljs-subst">${log.detail}</span>&lt;/div&gt;
                    &lt;/div&gt;
                `</span>;
                logContainer.appendChild(item);
            });
        }

        <span class="hljs-comment">// Render Memos</span>
        <span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">addMemo</span>(<span class="hljs-params"></span>) </span>{
            <span class="hljs-keyword">const</span> input = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'memoInput'</span>);
            <span class="hljs-keyword">if</span> (!input.value.trim()) <span class="hljs-keyword">return</span>;

            memos.unshift(input.value.trim());
            <span class="hljs-built_in">localStorage</span>.setItem(<span class="hljs-string">'care_memos_orange'</span>, <span class="hljs-built_in">JSON</span>.stringify(memos));
            input.value = <span class="hljs-string">''</span>;
            renderMemos();
        }

        <span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">renderMemos</span>(<span class="hljs-params"></span>) </span>{
            <span class="hljs-keyword">const</span> container = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'memoList'</span>);
            container.innerHTML = <span class="hljs-string">''</span>;

            <span class="hljs-keyword">if</span> (memos.length === <span class="hljs-number">0</span>) {
                container.innerHTML = <span class="hljs-string">'&lt;p style="text-align:center; color:var(--text-sub); font-size:0.85rem; padding: 10px;"&gt;メモはありません💬&lt;/p&gt;'</span>;
                <span class="hljs-keyword">return</span>;
            }

            memos.forEach(<span class="hljs-function">(<span class="hljs-params">memo, index</span>) =&gt;</span> {
                <span class="hljs-keyword">const</span> div = <span class="hljs-built_in">document</span>.createElement(<span class="hljs-string">'div'</span>);
                div.className = <span class="hljs-string">'log-item'</span>;
                div.style.background = <span class="hljs-string">'#FFF8F0'</span>;
                div.innerHTML = <span class="hljs-string">`
                    &lt;div class="log-content"&gt;
                        &lt;div class="log-detail" style="color:var(--text-main); font-size:0.9rem; font-weight: 500;"&gt;<span class="hljs-subst">${memo}</span>&lt;/div&gt;
                    &lt;/div&gt;
                    &lt;button style="border:none; background:none; color:#FF7E5F; cursor:pointer; font-size: 1.1rem;" onclick="deleteMemo(<span class="hljs-subst">${index}</span>)"&gt;
                        &lt;i class="fa-solid fa-trash-can"&gt;&lt;/i&gt;
                    &lt;/button&gt;
                `</span>;
                container.appendChild(div);
            });
        }

        <span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">deleteMemo</span>(<span class="hljs-params">index</span>) </span>{
            memos.splice(index, <span class="hljs-number">1</span>);
            <span class="hljs-built_in">localStorage</span>.setItem(<span class="hljs-string">'care_memos_orange'</span>, <span class="hljs-built_in">JSON</span>.stringify(memos));
            renderMemos();
        }

        <span class="hljs-comment">// Calculate Stress Logic</span>
        <span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">calculateStress</span>(<span class="hljs-params"></span>) </span>{
            <span class="hljs-keyword">const</span> q1 = <span class="hljs-built_in">document</span>.querySelector(<span class="hljs-string">'input[name="q1"]:checked'</span>);
            <span class="hljs-keyword">const</span> q2 = <span class="hljs-built_in">document</span>.querySelector(<span class="hljs-string">'input[name="q2"]:checked'</span>);
            <span class="hljs-keyword">const</span> resultDiv = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'stressResult'</span>);

            <span class="hljs-keyword">if</span> (!q1 || !q2) {
                alert(<span class="hljs-string">'すべての質問を選んでくださいね！'</span>);
                <span class="hljs-keyword">return</span>;
            }

            <span class="hljs-keyword">const</span> score = <span class="hljs-built_in">parseInt</span>(q1.value) + <span class="hljs-built_in">parseInt</span>(q2.value);
            resultDiv.style.display = <span class="hljs-string">'block'</span>;

            <span class="hljs-keyword">if</span> (score &lt;= <span class="hljs-number">1</span>) {
                resultDiv.innerHTML = <span class="hljs-string">`
                    &lt;div style="background: linear-gradient(135deg, #FFF9E6, #FFEAA7); border-radius:16px; padding:16px; border: 1px solid #F0932B;"&gt;
                        &lt;h4 style="color:#D35400; font-weight:800;"&gt;🌸 心の状態: とても良好！&lt;/h4&gt;
                        &lt;p style="font-size:0.85rem; margin-top:6px; color:#2C3E50;"&gt;リフレッシュ上手ですね。この調子で自分も大切に過ごしていきましょう！&lt;/p&gt;
                    &lt;/div&gt;`</span>;
            } <span class="hljs-keyword">else</span> <span class="hljs-keyword">if</span> (score &lt;= <span class="hljs-number">3</span>) {
                resultDiv.innerHTML = <span class="hljs-string">`
                    &lt;div style="background: linear-gradient(135deg, #FFE5D9, #FFCAD4); border-radius:16px; padding:16px; border: 1px solid #FF7E5F;"&gt;
                        &lt;h4 style="color:#E67E22; font-weight:800;"&gt;🌼 心の状態: 少しお疲れ気味&lt;/h4&gt;
                        &lt;p style="font-size:0.85rem; margin-top:6px; color:#2C3E50;"&gt;頑張りすぎていませんか？甘いものを食べたり、少しだけ一人の時間を取ってみてください。&lt;/p&gt;
                    &lt;/div&gt;`</span>;
            } <span class="hljs-keyword">else</span> {
                resultDiv.innerHTML = <span class="hljs-string">`
                    &lt;div style="background: linear-gradient(135deg, #FFD2D2, #FF8E8E); border-radius:16px; padding:16px; border: 1px solid #EB4D4B;"&gt;
                        &lt;h4 style="color:#C0392B; font-weight:800;"&gt;🌺 心の状態: SOSサイン！&lt;/h4&gt;
                        &lt;p style="font-size:0.85rem; margin-top:6px; color:#2C3E50;"&gt;かなり負担が溜まっています。一人で抱え込まず、ケアマネジャーさん等に相談して介護サービスを増やしてみましょう。&lt;/p&gt;
                    &lt;/div&gt;`</span>;
            }
        }

        <span class="hljs-comment">// Init</span>
        renderLogs();
        renderMemos();
    </span><span class="hljs-tag">&lt;/<span class="hljs-name">script</span>&gt;</span>
<span class="hljs-tag">&lt;/<span class="hljs-name">body</span>&gt;</span>
<span class="hljs-tag">&lt;/<span class="hljs-name">html</span>&gt;</span>
</code></pre><!----></div></div></div><!----><!----><!----></code-block><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></response-element></div></message-content><!----></div></structured-content-container><!----><!----><!----><!----></model-response-content><div _ngcontent-ng-c1357127206="" class="response-footer complete gap"><!----><!----><!----><sources-list _ngcontent-ng-c1357127206="" class="sources-list ng-star-inserted"><!----></sources-list><!----><election-info-disclaimer _ngcontent-ng-c1357127206="" _nghost-ng-c2531033441="" class="ng-star-inserted" style="display: none;"><!----></election-info-disclaimer><finance-info-disclaimer _ngcontent-ng-c1357127206="" _nghost-ng-c1136367074="" class="ng-star-inserted" style="display: none;"><!----></finance-info-disclaimer><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></div></div><!----><!----><!----><sensitive-memories-banner _ngcontent-ng-c1357127206="" _nghost-ng-c746442083="" class="ng-star-inserted"><!----></sensitive-memories-banner><!----><!----><!----><!----></div></div><div _ngcontent-ng-c543715647="" class="response-container-footer ng-tns-c543715647-159 ng-star-inserted"><!----><!----><!----><message-actions _ngcontent-ng-c1357127206="" footer="" class="hide-on-print ng-tns-c3896640774-160 hide-action-bar ng-tns-c543715647-159 ng-star-inserted" _nghost-ng-c3896640774=""><div _ngcontent-ng-c3896640774="" class="actions-container-v2 ng-tns-c3896640774-